{
  "name": "active-agent-dashboard",
  "private": true,
  "description": "Build for the mounted ActiveAgent dashboard. Output is committed to app/assets/builds so host apps never run this.",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild index.jsx --bundle --minify --format=esm --outfile=../app/assets/builds/active_agent_dashboard.js --loader:.jsx=jsx --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i ./dashboard.css -o ../app/assets/builds/active_agent_dashboard.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.27.2",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@rails/actioncable": "^8.1.200",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0"
  }
}
