# frozen_string_literal: true

# ActiveAgent Dashboard Configuration
#
# This file configures the ActiveAgent telemetry dashboard.
# The dashboard is mounted at /activeagents by default (see config/routes.rb).

ActionAgent.configure do |config|
  # ==========================================================================
  # Authentication (required in production)
  # ==========================================================================
  #
  # Provide a lambda that receives the controller and performs
  # authentication. Return false or raise to deny access. Without one, the
  # dashboard serves a 403 in production — traces contain prompts, outputs
  # and error messages.
  #
  # Basic auth:
  #   config.authentication_method = ->(controller) {
  #     controller.authenticate_or_request_with_http_basic do |username, password|
  #       username == "admin" && password == Rails.application.credentials.dashboard_password
  #     end
  #   }
  #
  # Devise:
  #   config.authentication_method = ->(controller) {
  #     controller.authenticate_admin!
  #   }
  #
  # No authentication (development only!):
  #   config.authentication_method = nil
  #
  config.authentication_method = nil
  #
  # Where a browser is sent when it asks for a dashboard page without a valid
  # session; unset, it gets a minimal session-expired page. API clients get a
  # bare 401 either way. The sign-out path is what the header's "Sign out"
  # item POSTs to (with _method=delete); unset, the item is not shown.
  #
  # config.sign_in_path = "/sign_in"
  # config.sign_out_path = "/sign_out"

  # ==========================================================================
  # Ingest API authentication
  # ==========================================================================
  #
  # Bearer token other apps must send when posting traces
  # (/activeagents/api/traces) or evaluation reports
  # (/activeagents/api/evaluation_reports) to the mount. Leave unset only
  # when the mount is not reachable beyond your own machine; even then, any web
  # page open in a browser there can post form data to the trace endpoint.
  #
  # config.ingest_api_key = Rails.application.credentials.dig(:active_agent, :ingest_api_key)

  # ==========================================================================
  # Multi-tenant mode (SaaS platforms only)
  # ==========================================================================
  #
  # Scopes traces per account and authenticates ingest with per-account
  # keys. Most self-hosted installs should leave this off.
  #
  # config.multi_tenant = true
  # config.account_class = "Account"
  # config.user_class = "User"
  #
  # How the engine finds the signed-in user and their account. These have to
  # be resolvers rather than method names: the dashboard's controllers are
  # their own base class, so your app's `current_user` helper is not on them.
  # Read the session (or your auth library) directly — a resolver that calls
  # back into `current_user` reaches the engine's own accessor, not yours.
  #
  # config.current_user_resolver = ->(controller) {
  #   User.find_by(id: controller.session[:user_id])
  # }
  # config.current_account_resolver = ->(controller) {
  #   controller.send(:current_user)&.account
  # }
  #
  # With an owner model configured, an owner that does not resolve sees
  # nothing rather than everything. An empty dashboard for a signed-in user
  # means the resolver above returned nil.
  #
  # Each model is owned by one class: agents, sandboxes, recordings and code
  # sessions name the user first, keys and connections the account. With
  # both classes configured, the dashboard still resolves the account as the
  # owner, so a platform that scopes everything by account re-declares the
  # user-first models from `to_prepare` and maps a user to its account:
  #
  # Rails.application.config.to_prepare do
  #   [ActionAgent::Agent, ActionAgent::SandboxSession,
  #    ActionAgent::SessionRecording, ActionAgent::CodeSession].each do |model|
  #     model.owned_by :account, :user
  #   end
  # end
  # config.tenant_resolver = ->(owner) { owner.is_a?(User) ? owner.account : owner }
  #
  # An owner of another class than the one a model is owned by reads nothing
  # and is refused as a writer, so leaving this out shows an empty dashboard
  # rather than another tenant's records.

  # ==========================================================================
  # Permissions
  # ==========================================================================
  #
  # Who may perform the dashboard's privileged actions: storing provider
  # credentials (:manage_credentials), connecting GitHub (:manage_github),
  # creating and revoking API keys (:manage_api_keys), answering a paused
  # run's request for input (:answer_input_request), and the rest of
  # ActionAgent::PERMISSION_ACTIONS. Called with the signed-in user, the
  # action and the record it applies to; true allows, false denies with a
  # 403. Unset, anyone who passes authentication may do all of them. With
  # multi_tenant on, that is every member of every tenant, and the engine
  # logs a warning at boot until a checker is set.
  #
  # An exception from the checker denies. In multi-tenant mode a nil answer,
  # or no signed-in user, also denies; in single-tenant mode a nil answer
  # allows.
  #
  # config.permission_checker = ->(user, action, subject) {
  #   user.present? && user.admin?
  # }

  # ==========================================================================
  # Provider keys and members
  # ===================================================================
  #
  # Agent runs, the evaluation judge and the assistant use the account's
  # provider keys (Settings -> API Keys, or the Organization page) before
  # config/active_agent.yml. With :personal_override, each member may also
  # save a personal key per provider, which the runs they start use first.
  # A personal key sends the organization's agent traffic to that member's
  # own provider account, so it is off by default. It needs account_class;
  # the judge, sandboxes, Claude Code and Codex always use the account's keys.
  # A personal Ollama host decides where the server sends requests, so
  # saving or testing one asks the permission_checker above for
  # :manage_credentials, with the personal key (subject.personal?) as the
  # subject.
  #
  # config.provider_key_scope = :personal_override
  #
  # Credentials your app keeps elsewhere, tried after a personal key and
  # before the account's stored key. Declare actor: to learn who is acting
  # (nil for the judge and unattributed runs). With multi_tenant on, a
  # resolver that raises fails the run rather than falling back to
  # config/active_agent.yml. If it reads the provider_keys table, keep it
  # to organization rows (ActionAgent::ProviderKey.for_owner does).
  #
  # config.provider_credentials_resolver = ->(owner, provider, actor: nil) {
  #   owner.provider_credentials_for(provider)
  # }
  #
  # The Organization page's Team Members table, as
  # [{ id:, name:, email:, role: }], and where "+ Invite Member" links. Both
  # unset, the table lists the signed-in user and the button is hidden.
  #
  # config.members_resolver = ->(account) {
  #   account.members.map { |user| { id: user.id, name: user.name, email: user.email, role: user.role } }
  # }
  # config.member_invite_url = "/team/invitations/new"
=======
  # Input requests
  # ==========================================================================
  #
  # How long a paused run's request for input waits for an answer. A later
  # answer is refused with a 409, and the run fails. Schedule
  # ActionAgent::InputRequestExpiryJob to fail the runs whose requests
  # nobody answers or looks at.
  #
  # config.input_request_ttl = 1.day

  # ==========================================================================
  # Host integration
  # ==========================================================================
  #
  # Concerns your own models and controllers carry, applied to the engine's.
  # model_concerns are included into ActionAgent::ApplicationRecord, and so
  # into every engine model. controller_concerns are included into
  # ActionAgent::ApplicationController ahead of its own callbacks, and so
  # into every dashboard controller — not the bearer-token ingest endpoints.
  # Modules or their names; a name is resolved when the class loads.
  #
  # config.model_concerns = ["ConnectionSwitching"]
  # config.controller_concerns = ["RequestTagging"]

  # ==========================================================================
  # Ask ActiveAgents assistant
  # ==========================================================================
  #
  # A tool for developing and CI-ing agents. Answering a question sends
  # recorded prompts, outputs and evaluation report excerpts to a model
  # provider, so the page and its API are on in development and test only.
  # Set it to true to run it in another environment deliberately, or false
  # to remove it everywhere.
  #
  # config.assistant_enabled = true

  # ==========================================================================
  # GitHub
  # ===================================================================

  #
  # Checkout sandboxes clone repositories chosen in Settings -> Integrations.
  # Through a GitHub App, each checkout gets a one-hour token limited to its
  # one repository. Settings -> Integrations -> Create GitHub App registers
  # one for you and shows these values once; otherwise register the App with
  # "Request user authorization (OAuth) during installation" and "Redirect on
  # update" turned on and the callback URL
  # <mount>/api/github_installations/callback. Each setting falls back to its
  # GITHUB_APP_* environment variable.
  #
  # config.github_app_id = Rails.application.credentials.dig(:github_app, :id)
  # config.github_app_slug = Rails.application.credentials.dig(:github_app, :slug)
  # config.github_app_client_id = Rails.application.credentials.dig(:github_app, :client_id)
  # config.github_app_client_secret = Rails.application.credentials.dig(:github_app, :client_secret)
  # config.github_app_private_key = Rails.application.credentials.dig(:github_app, :private_key)
  #
  # Or an OAuth App, connected per owner with the callback URL
  # <mount>/api/github_connection/callback (GITHUB_CLIENT_ID and
  # GITHUB_CLIENT_SECRET when unset).
  #
  # config.github_client_id = Rails.application.credentials.dig(:github, :client_id)
  # config.github_client_secret = Rails.application.credentials.dig(:github, :client_secret)
=======
  # Recording the Run Agent workbench
  # ==========================================================================
  #
  # While the Run Agent workbench has a conversation open, the dashboard
  # records the page with rrweb, and the recording replays as the
  # conversation's browser lane. Field values are masked, elements marked
  # data-aa-secret and hidden inputs are left out, and the owner's stored
  # credentials are masked in every batch; what the page shows otherwise, the
  # conversation included, is recorded as shown. Set it to false to record
  # nothing: conversations still replay from their messages, model calls and
  # tool calls.
  #
  # config.capture_dashboard_sessions = false

  # ==========================================================================
  # Sandboxes
  # ==========================================================================
  #
  # Which backend boots sandboxes: :mock (the default, in memory, runs
  # nothing), :local, or one you register in sandbox_backends to run them in
  # containers. The SANDBOX_BACKEND environment variable overrides it.
  #
  # config.sandbox_service = :local
  # config.sandbox_backends = { "cloud_run" => "CloudRunService" }
  #
  # :local clones a repository connected in Settings -> Integrations onto
  # this machine and boots it as child processes of the dashboard, as the
  # checkout's .activeagents/sandbox.yml says. That runs the repository's
  # code, and Claude Code sessions in it, with the dashboard's privileges, so
  # it is off outside development and test until you enable it here.
  #
  # config.local_sandboxes_enabled = true
  # config.local_sandbox_root = Rails.root.join("tmp/action_agent/sandboxes")
  # config.local_sandbox_boot_timeout = 600   # seconds, for checkout, setup and boot
  #
  # Claude Code sessions in a ready checkout. Nobody is there to answer a
  # permission prompt: "acceptEdits" lets a session edit files in the
  # checkout and run filesystem commands, and anything else that would ask
  # is denied.
  #
  # config.claude_code_command = "claude"
  # config.claude_code_permission_mode = "acceptEdits"
  # config.claude_code_max_turns = nil        # Claude Code's own default
  # config.claude_code_timeout = 1800         # seconds
  # Codex uses a separate API-key connection in Settings -> Integrations.
  # config.codex_command = "codex"
  # config.codex_timeout = 1800               # seconds
  #
  # How sessions authenticate. :api_key (the default) uses the Anthropic API
  # key connected in Settings -> Integrations (from the Claude Console,
  # https://platform.claude.com). :local_login, with the :local backend only,
  # uses this machine's own Claude Code login (`claude /login`); the dashboard
  # never reads or stores it. Claude subscription tokens (`claude
  # setup-token`) are not accepted: Anthropic does not allow third-party apps
  # to hold Claude.ai credentials.
  #
  # config.claude_code_auth = :local_login
  #
  # Expired sandboxes are stopped by `bin/rails action_agent:sandbox:reap`.
  # Schedule it every few minutes.

  # ==========================================================================
  # UI
  # ==========================================================================
  #
  # Custom layout for dashboard views (the default layout loads Tailwind,
  # Turbo and Stimulus from CDNs — override for CSP-strict or air-gapped
  # environments).
  #
  # config.layout = "application"
end
