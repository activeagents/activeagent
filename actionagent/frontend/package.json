{
  "name": "action-agent-dashboard",
  "private": true,
  "description": "Build for the ActionAgent dashboard. Output is committed to app/assets/builds so host apps never run this.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "npm run build:js && npm run build:replay && npm run build:recorder && npm run build:css",
    "build:js": "esbuild index.jsx --bundle --minify --format=esm --outfile=../app/assets/builds/action_agent.js --loader:.jsx=jsx --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:replay": "esbuild replay/player.js --bundle --minify --format=iife --outfile=../app/assets/builds/action_agent_replay.js --loader:.css=text --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:recorder": "esbuild recorder/recorder.js --bundle --minify --format=esm --outfile=../app/assets/builds/action_agent_recorder.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i ./dashboard.css -o ../app/assets/builds/action_agent.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.27.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@rails/actioncable": "^8.1.200",
    "@rrweb/record": "^2.1.7",
    "@rrweb/replay": "^2.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0"
  }
}
