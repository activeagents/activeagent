<p><%= link_to "Back to traces", traces_path %></p>
<article class="panel">
  <h1><%= @trace.display_name %></h1>
  <p class="badge <%= @trace.error? ? 'error' : 'success' %>"><%= @trace.error? ? "Error" : "Success" %></p>
  <p><time><%= @trace.timestamp&.strftime("%Y-%m-%d %H:%M:%S") %></time></p>
  <%= render "trace_detail", trace: @trace %>
</article>
