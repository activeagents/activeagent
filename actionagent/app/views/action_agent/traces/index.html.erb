<h1>Traces</h1>
<%= render "summary" %>
<section class="panel" aria-label="Recent traces">
  <h2>Recent Traces</h2>
  <p><%= link_to "All", traces_path %> · <%= link_to "Errors", traces_path(status: "error") %></p>
  <% if @traces.any? %>
    <% @traces.each do |trace| %>
      <details class="panel">
        <summary>
          <span class="trace-summary">
            <strong><%= trace.display_name %></strong>
            <span class="badge <%= trace.error? ? 'error' : 'success' %>"><%= trace.error? ? "Error" : "OK" %></span>
            <span><%= trace.formatted_duration %></span>
            <span><%= trace.formatted_tokens %> tokens</span>
            <span class="muted"><%= time_ago_in_words(trace.timestamp || trace.created_at) %> ago</span>
          </span>
        </summary>
        <%= link_to "Open trace", trace_path(trace) %>
        <%= render "trace_detail", trace: trace %>
      </details>
    <% end %>
  <% else %>
    <h2>No traces yet</h2>
    <p>Traces will appear here when your agents generate responses.</p>
  <% end %>
</section>
