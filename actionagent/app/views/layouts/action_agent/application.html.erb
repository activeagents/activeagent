<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ActiveAgent Trace Console</title>
  <% if @refresh_interval %>
    <meta http-equiv="refresh" content="<%= @refresh_interval %>">
  <% end %>
  <%= render "action_agent/traces/styles" %>
</head>
<body class="trace-console">
  <header>
    <nav aria-label="Trace console">
      <strong>ActiveAgent</strong>
      <%= link_to "Traces", traces_path %>
      <%= link_to "Metrics", metrics_traces_path %>
      <span class="muted">Local Telemetry</span>
    </nav>
  </header>
  <main>
    <div class="refresh-controls">
      <% if @refresh_interval %>
        <span>Refreshes every <%= @refresh_interval %> seconds.</span>
        <%= link_to "Stop refreshing", "#{request.path}?#{request.query_parameters.except('refresh').to_query}" %>
      <% else %>
        <%= link_to "Auto-refresh", "#{request.path}?#{request.query_parameters.merge('refresh' => '30').to_query}" %>
      <% end %>
      <%= link_to "Refresh now", request.path + (request.query_string.present? ? "?#{request.query_string}" : "") %>
    </div>
    <%= yield %>
  </main>
</body>
</html>
