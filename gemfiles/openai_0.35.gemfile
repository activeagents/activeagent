# frozen_string_literal: true

source "https://rubygems.org"

gem "minitest", "~> 5.0"
gem "openai", "~> 0.35.0"
gem "rails", "~> 8.0.0"
# json 3.0 (released 2026-09-07) made the options to JSON.parse and
# JSON.generate keyword-only; the released Rails (7.2 through 8.1.3.1) still
# passes them positionally, so every boot aborts in db:migrate. Rails main
# has adapted, which is why railsmain.gemfile carries no pin.
gem "json", "< 3"
gem "sqlite3", "~> 2.0"

gemspec path: ".."
gemspec path: "../actionagent", name: "actionagent"
