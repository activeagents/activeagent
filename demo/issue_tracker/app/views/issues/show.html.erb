<% content_for :title, "#{@issue.reference} #{@issue.title} · Snag" %>

<div class="page-head">
  <div>
    <p class="crumb"><%= link_to "Issues", issues_path %> / <%= @issue.reference %></p>
    <h1><%= @issue.title %></h1>
  </div>
  <div class="actions">
    <%= link_to "Edit", edit_issue_path(@issue), class: "button button-quiet" %>
    <%= button_to "Delete", @issue, method: :delete, class: "button button-danger",
          form: { data: { turbo_confirm: "Delete #{@issue.reference}?" } } %>
  </div>
</div>

<div class="detail">
  <section class="detail-main">
    <div class="body"><%= simple_format(@issue.body.presence || "No description.") %></div>

    <h2>Activity</h2>
    <% if @issue.comments.empty? %>
      <p class="muted">No comments yet.</p>
    <% end %>
    <% @issue.comments.includes(:author).each do |comment| %>
      <article class="comment <%= "comment-agent" if comment.via_agent %>" id="comment-<%= comment.id %>">
        <header>
          <%= avatar comment.author %> <strong><%= comment.author.name %></strong>
          <% if comment.via_agent %><span class="badge via">via agent</span><% end %>
          <span class="muted"><%= time_ago_in_words(comment.created_at) %> ago</span>
        </header>
        <%= simple_format(comment.body) %>
      </article>
    <% end %>

    <%= form_with model: [ @issue, @comment ], class: "comment-form" do |form| %>
      <%= form.text_area :body, rows: 3, placeholder: "Add a comment", required: true %>
      <%= form.submit "Comment", class: "button" %>
    <% end %>
  </section>

  <aside class="detail-side">
    <dl>
      <dt>Status</dt><dd><%= badge :status, @issue.status %></dd>
      <dt>Priority</dt><dd><%= badge :priority, @issue.priority %></dd>
      <dt>Component</dt><dd><%= @issue.component.presence || "None" %></dd>
      <dt>Assignee</dt><dd><%= avatar @issue.assignee %> <%= @issue.assignee&.name || "Unassigned" %></dd>
      <dt>Reporter</dt><dd><%= avatar @issue.reporter %> <%= @issue.reporter.name %></dd>
      <% if @issue.duplicate_of %>
        <dt>Duplicate of</dt><dd><%= link_to "#{@issue.duplicate_of.reference} #{@issue.duplicate_of.title}", @issue.duplicate_of %></dd>
      <% end %>
      <% if @issue.duplicates.any? %>
        <dt>Duplicates</dt>
        <dd><% @issue.duplicates.each do |dup| %><%= link_to dup.reference, dup %> <% end %></dd>
      <% end %>
      <dt>Filed</dt><dd><%= @issue.created_at.to_fs(:long) %></dd>
      <% if @issue.closed_at %><dt>Closed</dt><dd><%= @issue.closed_at.to_fs(:long) %></dd><% end %>
    </dl>
  </aside>
</div>
