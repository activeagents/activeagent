<% content_for :title, "Issues · Snag" %>

<div class="page-head">
  <h1>Issues</h1>
  <%= link_to "New issue", new_issue_path, class: "button" %>
</div>

<div class="filters">
  <div class="chips">
    <%= filter_link "Active", { status: nil }, count: @counts.values_at("open", "in_progress").compact.sum %>
    <% Issue::STATUSES.each do |status| %>
      <%= filter_link status.humanize, { status: status }, count: @counts[status] || 0 %>
    <% end %>
    <%= filter_link "All", { status: "all" } %>
  </div>

  <%= form_with url: issues_path, method: :get, class: "filter-form" do |form| %>
    <%= form.hidden_field :status, value: @filters["status"] %>
    <%= form.search_field :q, value: @filters["q"], placeholder: "Search title and description" %>
    <%= form.select :priority, Issue::PRIORITIES.map { [ _1.humanize, _1 ] }, { include_blank: "Any priority", selected: @filters["priority"] } %>
    <%= form.select :component, Issue::COMPONENTS.map { [ _1.humanize, _1 ] }, { include_blank: "Any component", selected: @filters["component"] } %>
    <%= form.select :assignee_id, [ [ "Unassigned", "none" ] ] + User.order(:name).pluck(:name, :id), { include_blank: "Anyone", selected: @filters["assignee_id"] } %>
    <%= form.submit "Filter", class: "button button-quiet" %>
  <% end %>
</div>

<% if @issues.empty? %>
  <p class="empty">No issues match. <%= link_to "Clear filters", issues_path %>.</p>
<% else %>
  <table class="issues">
    <thead>
      <tr><th class="num">#</th><th>Title</th><th>Status</th><th>Priority</th><th>Component</th><th>Assignee</th><th class="when">Updated</th></tr>
    </thead>
    <tbody>
      <% @issues.each do |issue| %>
        <tr class="<%= "is-done" if issue.done? %>">
          <td class="num"><%= issue.id %></td>
          <td class="title">
            <%= link_to issue.title, issue %>
            <% if issue.duplicate_of_id %><span class="dup">duplicate of #<%= issue.duplicate_of_id %></span><% end %>
          </td>
          <td><%= badge :status, issue.status %></td>
          <td><%= badge :priority, issue.priority %></td>
          <td class="muted"><%= issue.component %></td>
          <td class="who"><%= avatar issue.assignee %> <span class="muted"><%= issue.assignee&.name || "Unassigned" %></span></td>
          <td class="when muted"><%= time_ago_in_words(issue.updated_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
