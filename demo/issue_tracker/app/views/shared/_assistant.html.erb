<% agent = Assistant.agent %>
<% if agent %>
  <% content_for :body_class, "has-assistant" %>
  <% turns = Assistant.turns(agent, session) %>
  <aside class="assistant" data-controller="assistant">
    <header>
      <div>
        <strong><%= agent.name %></strong>
        <span class="muted"><%= agent.model %></span>
      </div>
      <% if turns.any? %>
        <%= button_to "New chat", assistant_messages_path, method: :delete, class: "link-button" %>
      <% end %>
    </header>

    <div class="assistant-log" data-assistant-target="log">
      <% if turns.empty? %>
        <div class="assistant-empty">
          <p>Ask about the backlog, or ask for a change.</p>
          <ul>
            <li>What's urgent right now?</li>
            <li>Is there already an issue about gift cards?</li>
            <li>Who owns auth, and what's on their plate?</li>
          </ul>
        </div>
      <% end %>
      <% turns.each do |turn| %>
        <div class="turn turn-<%= turn.role %>">
          <% if turn.tools.any? %>
            <p class="turn-tools"><% turn.tools.each do |tool| %><code><%= tool %></code><% end %></p>
          <% end %>
          <%= simple_format(turn.content) %>
        </div>
      <% end %>
    </div>

    <%= form_with url: assistant_messages_path, class: "assistant-form",
          data: { assistant_target: "form", action: "submit->assistant#sending" } do |form| %>
      <%= form.text_area :message, rows: 2, required: true, placeholder: "Message #{agent.name}",
            data: { assistant_target: "input", action: "keydown->assistant#keydown" } %>
      <%= form.submit "Send", class: "button", data: { assistant_target: "send" } %>
    <% end %>
  </aside>
<% else %>
  <aside class="assistant-missing">
    <strong>No agent yet.</strong>
    Build one named “Issue Agent” in the
    <%= link_to "dashboard", "/activeagents", target: "_blank", rel: "noopener", data: { turbo: false } %>
    and it will appear here.
  </aside>
<% end %>
