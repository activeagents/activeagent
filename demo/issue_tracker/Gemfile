# The framework and its dashboard, from this checkout. In your own app:
#   gem "activeagent"
#   gem "actionagent"
gem "activeagent", path: "../.."
gem "actionagent", path: "../../actionagent"

# Provider clients. The demo runs on Anthropic by default; the mock provider
# (DEMO_PROVIDER=mock) needs neither.
gem "anthropic"
