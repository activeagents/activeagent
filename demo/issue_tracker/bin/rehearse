#!/usr/bin/env bash
# Runs the demo against the scripted stand-in provider: no key, no network.
# See script/rehearsal_provider.rb for what it can and cannot answer.
set -euo pipefail
cd "$(dirname "$0")/.."

port="${REHEARSAL_PORT:-4010}"
bundle exec ruby script/rehearsal_provider.rb &
provider=$!
trap 'kill "$provider" 2>/dev/null || true' EXIT INT TERM

sleep 2
if ! kill -0 "$provider" 2>/dev/null; then
  echo "The rehearsal provider did not start. Is port ${port} already in use?" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="http://127.0.0.1:${port}"
export ANTHROPIC_API_KEY="rehearsal"
echo "Rehearsal provider on ${ANTHROPIC_BASE_URL}. The app answers from a script, not a model."
bin/rails server "$@"
